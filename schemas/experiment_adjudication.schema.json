{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pur-new/experiment_adjudication.schema.json",
  "title": "Human-executed wet-lab adjudication",
  "description": "Post-experiment record linked to an immutable Agent recommendation by recommendation_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adjudication_id",
    "recommendation_id",
    "experiment_date",
    "executed_by_human",
    "executed_state",
    "measurement_reference",
    "criterion_comparison",
    "status",
    "provenance"
  ],
  "properties": {
    "adjudication_id": {"type": "string", "minLength": 1},
    "recommendation_id": {"type": "string", "minLength": 1},
    "experiment_date": {"type": "string", "minLength": 1},
    "executed_by_human": {"const": true},
    "executed_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formulation_state", "process_state"],
      "properties": {
        "formulation_state": {"type": "object", "additionalProperties": true},
        "process_state": {"type": "object", "additionalProperties": true}
      }
    },
    "deviation_from_recommended_state": {
      "type": ["string", "null"]
    },
    "measurement_reference": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "observed_summary": {
      "type": ["string", "null"]
    },
    "derived_metrics": {
      "type": "object",
      "additionalProperties": true
    },
    "criterion_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_as_frozen", "comparison"],
      "properties": {
        "criterion_as_frozen": {"type": "string", "minLength": 1},
        "comparison": {"type": "string", "minLength": 1},
        "criterion_modified_after_result": {"const": false}
      }
    },
    "status": {
      "enum": ["supported", "partially_supported", "falsified", "out_of_domain"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_commit": {"type": ["string", "null"]},
        "source_files": {"type": "array", "items": {"type": "string"}},
        "recorded_utc": {"type": ["string", "null"]},
        "recorded_by": {"type": ["string", "null"]}
      }
    },
    "note": {"type": ["string", "null"]}
  }
}

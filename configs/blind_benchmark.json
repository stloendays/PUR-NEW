{
  "benchmark_id": "PUR_NEW_BLIND_AGENT_V1",
  "benchmark_version": "1.0.0",
  "primary_profile": "blind_pre_result",
  "candidate_set": {
    "generator": "scripts/build_candidate_set.py",
    "default_modifier_grid_pct": [0, 5, 10, 15, 18, 20, 25],
    "exact_recovery_modifier_pct": 18,
    "supported_region_pct": [15, 21],
    "near_experimental_region_pct": [17, 20]
  },
  "run_protocol": {
    "pilot_runs_per_model": 5,
    "full_runs_per_model": 30,
    "store_failed_runs": true,
    "store_abstentions": true,
    "require_same_blind_payload_across_models": true,
    "recommended_temperature": 0.2,
    "seed_policy": "record_if_endpoint_supports_seed; otherwise record run_index and treat calls as repeated stochastic realizations"
  },
  "primary_metrics": [
    "exact_grid_top1_recovery",
    "supported_region_top1_recovery",
    "supported_region_top3_recall",
    "near_experimental_top3_recall",
    "selection_distribution",
    "abstention_rate"
  ],
  "diagnostics": [
    "dominant_uncertainty_identification",
    "resin_family_reasoning",
    "external_prior_use",
    "process_history_uncertainty_use",
    "scientific_boundary_violations"
  ],
  "ablations": [
    "literature_only_sanity",
    "blind_pre_result",
    "blind_pre_result_without_external_hints"
  ],
  "anti_leakage": {
    "forbid_follow_up_hold_results_in_agent_payload": true,
    "forbid_adjudication_labels_in_agent_payload": true,
    "forbid_benchmark_target_region_in_agent_payload": true,
    "forbid_post_result_text_derived_from_follow_up_in_agent_payload": true,
    "controller_may_read_scoring_labels": true
  },
  "artifact_layout": "records/benchmarks/<benchmark_id>/",
  "note": "The target region is used only by the benchmark controller after model responses are collected. It must never be included in the evaluated Agent request."
}

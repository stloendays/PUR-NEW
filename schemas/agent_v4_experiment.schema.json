{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PUR-NEW Agent V4 frozen experiment recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation_id",
    "architecture_version",
    "workflow_version",
    "decision_mode",
    "selected_experiment_id",
    "selected_candidate_id",
    "selected_measurement_id",
    "experiment_card",
    "hypotheses_addressed",
    "hypotheses_left_entangled",
    "acceptance_criterion",
    "falsification_criterion",
    "uncertainty_decomposition",
    "voi",
    "frozen_utc",
    "model",
    "prompt_hash",
    "input_hash",
    "inspection_status"
  ],
  "properties": {
    "recommendation_id": {"type": "string"},
    "architecture_version": {"type": "string"},
    "workflow_version": {"type": "string"},
    "decision_mode": {
      "type": "string",
      "enum": ["committed_experiment", "discriminating_probe", "state_control_experiment", "abstain"]
    },
    "selected_experiment_id": {"type": ["string", "null"]},
    "selected_candidate_id": {"type": ["string", "null"]},
    "selected_measurement_id": {"type": ["string", "null"]},
    "experiment_card": {"type": ["object", "null"]},
    "primary_observable": {"type": ["string", "null"]},
    "hypotheses_addressed": {"type": "array", "items": {"type": "string"}},
    "hypotheses_left_entangled": {"type": "array", "items": {"type": "string"}},
    "acceptance_criterion": {"type": ["string", "null"]},
    "falsification_criterion": {"type": ["string", "null"]},
    "next_experiment_if_falsified": {"type": ["string", "null"]},
    "uncertainty_decomposition": {"type": "object"},
    "voi": {
      "type": "object",
      "required": ["score", "components", "weights", "tied_top_set", "formula"],
      "properties": {
        "score": {"type": ["number", "null"]},
        "components": {"type": ["object", "null"]},
        "weights": {"type": "object"},
        "tied_top_set": {"type": "array", "items": {"type": "string"}},
        "selected_is_in_tied_top_set": {"type": ["boolean", "null"]},
        "formula": {"type": "string"}
      }
    },
    "stage_disagreements_resolved": {"type": ["string", "null"]},
    "rationale": {"type": ["string", "null"]},
    "frozen_utc": {"type": "string"},
    "model": {"type": "string"},
    "prompt_hash": {"type": "string"},
    "input_hash": {"type": "string"},
    "candidate_set_hash": {"type": "string"},
    "hypothesis_registry_hash": {"type": "string"},
    "measurement_catalog_hash": {"type": "string"},
    "git_commit": {"type": ["string", "null"]},
    "inspection_status": {"type": "string"},
    "claim_boundary": {"type": "string"}
  }
}
